---
interface Props { title: string; description?: string }
const { title, description = 'Praktiske og uavhengige råd om digitalt personvern.' } = Astro.props;
---
<!doctype html>
<html lang="nb">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="description" content={description} /><title>{title} – Tenk deg om</title>
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
<style is:global>
:root{font-family:system-ui,-apple-system,sans-serif;color:#193b30;background:#f7faf7}*{box-sizing:border-box}body{margin:0}a{color:#126047}a:hover{text-decoration-thickness:2px}a:focus-visible,button:focus-visible{outline:3px solid #a66500;outline-offset:3px}header,main,footer{max-width:1000px;margin:auto;padding:1.3rem}header{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;border-bottom:1px solid #d5e2da}header .brand{font-weight:800;font-size:1.3rem;text-decoration:none}nav{display:flex;gap:1rem;flex-wrap:wrap}main{min-height:65vh}h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.15}h2{margin-top:2rem}p,li{line-height:1.75}article{max-width:760px}article p{font-size:1.08rem}.lead{font-size:1.22rem;max-width:760px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem}.card{background:#fff;border:1px solid #d5e2da;border-radius:12px;padding:1.3rem}.card h2{font-size:1.25rem;margin-top:0}.button{display:inline-block;background:#126047;color:white;padding:.85rem 1.1rem;border-radius:8px;text-decoration:none;font-weight:700}footer{border-top:1px solid #d5e2da;color:#4a6055;font-size:.9rem;margin-top:3rem}.skip{position:absolute;left:-9999px}.skip:focus{left:1rem;top:1rem;background:white;padding:.7rem;z-index:10}.note{background:#e9f3ec;border-left:4px solid #126047;padding:1rem}
</style>
</head>
<body><a class="skip" href="#innhold">Hopp til innhold</a>
<header><a class="brand" href="/">Tenk deg om.</a><nav aria-label="Hovedmeny"><a href="/laer/">Lær</a><a href="/personvernsjekken/">Personvernsjekken</a><a href="/om/">Om oss</a></nav></header>
<main id="innhold"><slot /></main>
<footer>Utgitt av Ploos AS · Folkeopplysning først · <a href="/om/">Redaksjonelle prinsipper</a> · <a href="/personvern/">Personvern på nettstedet</a></footer>
</body></html>