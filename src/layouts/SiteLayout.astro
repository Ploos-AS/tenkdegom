---
import '../styles/global.css';
interface Props { title: string; description?: string; articleMeta?: { publishedAt: string; updatedAt: string } }
const { title, articleMeta, description = 'Praktiske og uavhengige råd om digitalt personvern.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const navItems = [
  { href: '/', label: 'Hjem' },
  { href: '/laer/', label: 'Lær' },
  { href: '/personvernsjekken/', label: 'Personvernsjekken' },
  { href: '/ressurser/', label: 'Hjelp og ressurser' },
  { href: '/om/', label: 'Om oss' },
  { href: '/kontakt/', label: 'Kontakt' }
];
---
<!doctype html>
<html lang="nb">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} – Tenk deg om</title>
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={articleMeta ? "article" : "website"} />
  <meta property="og:site_name" content="Tenk deg om" />
  {articleMeta && <meta property="article:published_time" content={articleMeta.publishedAt} />}
  {articleMeta && <meta property="article:modified_time" content={articleMeta.updatedAt} />}
  <meta property="og:locale" content="nb_NO" />
  <meta property="og:title" content={`${title} – Tenk deg om`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL("/og-image.png", Astro.site).toString()} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Tenk deg om. Personvern angår oss alle. Norsk varselskilt." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} – Tenk deg om`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image:alt" content="Tenk deg om. Personvern angår oss alle. Norsk varselskilt." />
  <meta name="twitter:image" content={new URL("/og-image.png", Astro.site).toString()} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

</head>
<body>
<a class="skip" href="#innhold">Hopp til innhold</a>
<header class="site-header">
  <a class="brand" href="/" aria-label="Tenk deg om – til forsiden"><img class="brand-mark" src="/favicon.svg" alt="" width="36" height="36" /><span>Tenk deg om.</span></a>
  <nav class="site-nav" aria-label="Hovedmeny">
    {navItems.map(item => <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
  </nav>
</header>
<main class="site-main" id="innhold" tabindex="-1"><slot /></main>
<footer class="site-footer">Utgitt av <a href="https://www.ploos.no/">Ploos AS</a> · Folkeopplysning først · <a href="/om/">Redaksjonelle prinsipper</a> · <a href="/personvern/">Personvern på nettstedet</a> · <a href="https://ko-fi.com/tenkdegom" target="_blank" rel="noopener noreferrer">☕ Støtt oss</a></footer>
</body>
</html>