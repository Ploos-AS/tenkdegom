---
import SiteLayout from '../layouts/SiteLayout.astro';
import { articles } from '../data/articles';

const fixedSlugs = ['ti-enkle-personverngrep', 'ikke-noe-a-skjule'];
const fixedArticles = fixedSlugs.map(slug => articles.find(article => article.slug === slug));
if (fixedArticles.some(article => !article)) throw new Error('A featured article is missing');
const newestArticle = [...articles]
  .filter(article => !fixedSlugs.includes(article.slug))
  .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))[0];
const featuredArticles = [...fixedArticles, newestArticle].filter(article => article !== undefined);
---
<SiteLayout title="Personvern angår oss alle" description="Gratis, forståelig og uavhengig folkeopplysning om digitalt personvern.">
  <section style="padding:3rem 0">
    <h1>Personvern angår oss alle.</h1>
    <p class="lead">Hva deler du, hvem får tilgang – og hvilke valg har du? Vi gjør digitalt personvern forståelig, med gratis kunnskap og praktiske råd.</p>
    <a class="button" href="/personvernsjekken/">Ta Personvernsjekken</a>
  </section>
  <section aria-labelledby="utforsk">
    <h2 id="utforsk">Kom i gang</h2>
    <div class="cards">
      <div class="card"><h2><a href="/laer/">Lær om personvern</a></h2><p>Praktiske artikler om kontoer, sporing og KI.</p></div>
      <div class="card"><h2><a href="/personvernsjekken/">Personvernsjekken</a></h2><p>12 spørsmål. Ingen lagring av svar.</p></div>
      <div class="card"><h2><a href="/om/">Om prosjektet</a></h2><p>Hvem står bak, og hvilke prinsipper følger vi?</p></div>
    </div>
  </section>
  <section aria-labelledby="les-forst">
    <h2 id="les-forst">Les først</h2>
    <div class="featured-grid">
      {featuredArticles.map((a, i) => (
        <a class="featured-card" href={`/laer/${a.slug}/`}>
          <span class="eyebrow">{i === 2 ? "Sist publisert" : "Les først"}</span>
          <h3>{a.title}</h3>
          <p>{a.intro}</p>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>